{:paths ["src" "resources"]
 :deps {org.clojure/data.json {:mvn/version "2.5.0"}
        ;; W6 product-shell oracle authority: execute precompiled pure-request
        ;; KIR (resources/cloudflare/oracle/*.kir.edn). Compiler stays :test-only.
        io.github.kotoba-lang/kotoba-kir
        {:git/url "https://github.com/kotoba-lang/kotoba-kir.git"
         :git/sha "6d08e3cffa09c003f8dbcdfaee964c4a1ea021ad"}}
 :aliases
 {:test {:extra-paths ["test"]
         ;; kotoba-lang/compiler is TEST-ONLY for the W6 pure-request oracle
         ;; parity gate + product-shell artifact gen. Override abi to the pin
         ;; compiler expects so component/wit loads cleanly in the test JVM.
         :override-deps
         {io.github.kotoba-lang/abi
          {:git/url "https://github.com/kotoba-lang/abi.git"
           :git/sha "34415ce9bf2b8d37d5bc8259ba7e00f5d091eb44"}}
         ;; kotoba-lang/edn is TEST-ONLY too: `kotoba-oracle-gen` lives under
         ;; test/ and post-processes its pprint output through
         ;; `escape-controls`, so the KIR artefacts cannot be written with raw
         ;; control bytes. Both aliases that put test/ on the path need it.
         :extra-deps {io.github.kotoba-lang/edn
                      {:git/url "https://github.com/kotoba-lang/edn.git"
                       :git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}
                      io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}
                      io.github.kotoba-lang/compiler
                      {:git/url "https://github.com/kotoba-lang/compiler.git"
                       :git/sha "b0095427fdc1b52153b285e6443591f2196c20a6"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}

  ;; Regenerate product-shell KIR (does not run test-runner).
  :oracle-gen {:extra-paths ["test"]
               :override-deps
               {io.github.kotoba-lang/abi
                {:git/url "https://github.com/kotoba-lang/abi.git"
                 :git/sha "34415ce9bf2b8d37d5bc8259ba7e00f5d091eb44"}}
               :extra-deps {io.github.kotoba-lang/edn
                            {:git/url "https://github.com/kotoba-lang/edn.git"
                             :git/sha "250f4dafa5f5c7fb3109703496a52866e2a62dcd"}
                            io.github.kotoba-lang/compiler
                            {:git/url "https://github.com/kotoba-lang/compiler.git"
                             :git/sha "b0095427fdc1b52153b285e6443591f2196c20a6"}}
               :main-opts ["-m" "cloudflare.kotoba-oracle-gen"]}

  ;; Regenerate the cross-runtime oracle case table (test/cloudflare/oracle_cases.edn).
  :oracle-cases-gen {:extra-paths ["test"]
                     :main-opts ["-m" "cloudflare.oracle-cases-gen"]}

  ;; clj-kondo as a Clojars lib (no Homebrew/system install needed).
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts ["-m" "clj-kondo.main" "--lint" "src" "test"
                     "--fail-level" "error"]}}}
