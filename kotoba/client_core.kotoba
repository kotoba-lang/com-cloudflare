(ns client-core
  (:export [api-base graphql-endpoint
            api-token-secret-name api-token-env-name
            default-content-type method-get method-post method-put method-delete
            blank? ws? query-pair with-query rest-url graphql-url
            bearer-auth secret-name-matches? transport-ok?
            prefer-explicit-token?]))

;; W6 pure-request oracle — cloudflare.client constants + URL/auth helpers.
;; jvm-http-fn / rest! / graphql! / getenv stay host.
;; Parity: test/cloudflare/client_kotoba_parity_test.clj

(defn api-base [] :string
  "https://api.cloudflare.com/client/v4")

(defn graphql-endpoint [] :string
  (string-concat (api-base) "/graphql"))

(defn api-token-secret-name [] :string
  "cloudflare-api-token")

(defn api-token-env-name [] :string
  "CLOUDFLARE_API_TOKEN")

(defn default-content-type [] :string
  "application/json")

(defn method-get [] :string "get")
(defn method-post [] :string "post")
(defn method-put [] :string "put")
(defn method-delete [] :string "delete")

(defn ws? [c :string] :i64
  (if (string=? c " ")
    1
    (if (string=? c "\n")
      1
      (if (string=? c "\t")
        1
        (if (string=? c "\r") 1 0)))))

(defn blank? [s :string] :i64
  (let [n (string-byte-length s)]
    (if (= n 0)
      1
      (if (= (ws? (string-substring s 0 1)) 1)
        (blank? (string-substring s 1 n))
        0))))

(defn query-pair [k :string v :string] :string
  ;; cljc: (str (name k) "=" v) — host projects keyword name as string
  (string-concat k (string-concat "=" v)))

(defn with-query [path :string qs :string] :string
  ;; empty qs ≡ no query map
  (if (string=? qs "")
    path
    (string-concat path (string-concat "?" qs))))

(defn rest-url [path :string qs :string] :string
  (string-concat (api-base) (with-query path qs)))

(defn graphql-url [] :string
  (graphql-endpoint))

(defn bearer-auth [token :string] :string
  (string-concat "Bearer " token))

(defn secret-name-matches? [name :string] :i64
  ;; env-token-fetch only maps api-token-secret-name
  (if (string=? name (api-token-secret-name)) 1 0))

(defn transport-ok? [status :i64] :i64
  ;; cljc: (< status 300)
  (if (< status 300) 1 0))

(defn prefer-explicit-token? [token :string] :i64
  ;; cljc api-token: non-blank :token wins over fetch
  (if (= (blank? token) 1) 0 1))
